@page "/login"
@layout OrgNet.Pwa.Layout.MainLayout
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-header">
        <span class="login-brand-icon">&#xE770;</span>
        <h1>OrgNet</h1>
        <p>Digital Operating System</p>
    </div>

    <div class="login-card">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-bar">@_error</div>
        }

        <div class="form-group">
            <label>Email</label>
            <input type="email" @bind="_email" placeholder="you@company.com" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password" placeholder="Enter password" />
        </div>

        <button class="btn-primary" @onclick="HandleLogin" disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign In")
        </button>
    </div>
</div>

<style>
    .login-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100dvh;
        background: #0f0f0f;
        padding: 24px;
    }
    .login-header {
        text-align: center;
        margin-bottom: 32px;
    }
    .login-brand-icon {
        font-family: 'Segoe Fluent Icons', 'Segoe MDL2 Assets';
        font-size: 40px;
        color: #7c3aed;
    }
    .login-header h1 {
        color: white;
        font-size: 28px;
        margin: 8px 0 4px;
    }
    .login-header p {
        color: #6b7280;
        font-size: 14px;
    }
    .login-card {
        width: 100%;
        max-width: 380px;
        background: #1a1a2e;
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #1f2937;
    }
    .error-bar {
        background: #7f1d1d;
        color: #fca5a5;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 16px;
    }
    .form-group {
        margin-bottom: 16px;
    }
    .form-group label {
        display: block;
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 6px;
    }
    .form-group input {
        width: 100%;
        padding: 10px 14px;
        background: #111827;
        border: 1px solid #374151;
        border-radius: 8px;
        color: white;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }
    .form-group input:focus {
        border-color: #7c3aed;
    }
    .btn-primary {
        width: 100%;
        padding: 12px;
        background: #7c3aed;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }
    .btn-primary:hover { background: #6d28d9; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;
        var (success, error) = await Auth.LoginAsync(_email, _password);
        _loading = false;

        if (success)
            Nav.NavigateTo("/", forceLoad: true);
        else
            _error = error;
    }
}
