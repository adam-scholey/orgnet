@page "/announcements"
@attribute [Authorize]
@inject ApiClient Api

<div class="page-content">
    <h2 class="page-title">Announcements</h2>

    @if (_announcements?.Count > 0)
    {
        @foreach (var a in _announcements)
        {
            <div class="card">
                <div class="card-title">
                    @(a.IsPinned ? "📌 " : "")@a.Title
                </div>
                <div class="card-sub">@a.Body</div>
                <div class="card-meta">@a.Author · @a.PublishedAt.ToString("MMM dd, HH:mm")</div>
            </div>
        }
    }
    else
    {
        <div class="empty">No announcements yet</div>
    }
</div>

@code {
    private List<AnnouncementDto>? _announcements;

    protected override async Task OnInitializedAsync()
    {
        _announcements = await Api.GetAsync<List<AnnouncementDto>>("api/announcements");
    }
}
