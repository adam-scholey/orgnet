<Page
    x:Class="OrgNet.Desktop.Views.FileFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8B7;" FontSize="28"/>
            <TextBlock Text="FileFlow — Cloud File System" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status / Error Bar -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="StatusBar" Severity="Informational" Title="Status" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="NotConnectedBar" Severity="Warning" Title="Not Connected"
                     Message="FileFlow requires authentication. Enter your CloudFileSystem password to connect."
                     IsOpen="False" IsClosable="False"/>
        </StackPanel>

        <!-- Connect Panel (shown when not connected) -->
        <StackPanel x:Name="ConnectPanel" Grid.Row="2" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <PasswordBox x:Name="ConnectPasswordBox" Header="CloudFileSystem Password" PlaceholderText="Enter password" Width="300"/>
            <Button x:Name="ConnectButton" Content="Connect" VerticalAlignment="Bottom" Click="OnConnectClicked"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>

        <!-- Toolbar (shown when connected) -->
        <StackPanel x:Name="ToolbarPanel" Grid.Row="2" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <Button x:Name="UploadButton" Click="OnUploadClicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE898;" FontSize="16"/>
                    <TextBlock Text="Upload File"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Click="OnRefreshClicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="FileCountText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <!-- File List -->
        <ListView x:Name="FileListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="20" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UploadedAt}" FontSize="12" Opacity="0.5"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding FileSize}" VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>

                        <Button Grid.Column="3" ToolTipService.ToolTip="Download" Click="OnDownloadClicked" Tag="{Binding Id}" Padding="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        </Button>

                        <Button Grid.Column="4" ToolTipService.ToolTip="Delete" Click="OnDeleteClicked" Tag="{Binding Id}" Padding="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="IndianRed"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar x:Name="LoadingBar" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>
    </Grid>
</Page>
