<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Spacing="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="48" MaxWidth="600">
            <!-- Welcome -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE890;" FontSize="48" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome to OrgNet!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Let's get your workspace set up in a few quick steps." Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <!-- Step indicators -->
            <StackPanel x:Name="StepIndicators" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Ellipse x:Name="Step1Dot" Width="12" Height="12" Fill="{StaticResource PrimaryBrush}"/>
                <Ellipse x:Name="Step2Dot" Width="12" Height="12" Fill="{StaticResource SubtleBrush}"/>
                <Ellipse x:Name="Step3Dot" Width="12" Height="12" Fill="{StaticResource SubtleBrush}"/>
            </StackPanel>

            <!-- Step 1: Organisation Info -->
            <Border x:Name="Step1Panel" Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Step 1: Your Organisation" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Tell us about your organisation so we can customise your experience." Opacity="0.6"/>
                    <TextBlock x:Name="OrgNameDisplay" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OrgSectorDisplay" Opacity="0.6"/>
                    <Button Content="Next →" Click="OnNextStep" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Right" Tag="1"/>
                </StackPanel>
            </Border>

            <!-- Step 2: Key Features -->
            <Border x:Name="Step2Panel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Step 2: Your Modules" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Based on your sector, we've enabled these modules:" Opacity="0.6"/>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Chat — Real-time team messaging"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Files — AES-256 encrypted file vault"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Tasks — Kanban-style task management"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70B;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Notes — Collaborative documents"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE789;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Announcements — Org-wide broadcasts"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="← Back" Click="OnPrevStep" Style="{StaticResource Action}" Tag="2"/>
                        <Button Content="Next →" Click="OnNextStep" Style="{StaticResource PrimaryAction}" Tag="2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Step 3: Get Started -->
            <Border x:Name="Step3Panel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Step 3: You're All Set!" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Here are some quick tips to get started:" Opacity="0.6"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="• Use Alt+C to quickly jump to Chat" Opacity="0.7"/>
                        <TextBlock Text="• Use Alt+T to open your Task Board" Opacity="0.7"/>
                        <TextBlock Text="• Invite team members from User Management" Opacity="0.7"/>
                        <TextBlock Text="• Switch themes in Settings → Appearance" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="← Back" Click="OnPrevStep" Style="{StaticResource Action}" Tag="3"/>
                        <Button Content="Go to Dashboard →" Click="OnFinishOnboarding" Style="{StaticResource PrimaryAction}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
