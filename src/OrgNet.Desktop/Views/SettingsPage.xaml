<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageHeaderText}"/>
                <TextBlock Text="Organisation configuration and app preferences" Style="{StaticResource PageSubHeaderText}"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE770;" FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Organisation" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TenantNameText" Text="—" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Plan" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PlanText" Text="—" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sector" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SectorText" Text="—" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Members" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MemberCountText" Text="0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="18" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Local Cache" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Clear the local SQLite cache to force a full resync from the server." Opacity="0.6" TextWrapping="Wrap"/>
                    <Button Content="Clear Cache" Click="OnClearCache" Style="{StaticResource Action}"/>
                    <TextBlock x:Name="StatusText" Opacity="0.6" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="About" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="OrgNet Desktop v1.0.0" Opacity="0.6"/>
                    <TextBlock Text="Multi-tenant organisational digital workspace for Windows" Opacity="0.4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
