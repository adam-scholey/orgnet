<Page
    x:Class="OrgNet.Desktop.Views.FileVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Secure File Storage" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="AES-256 encrypted file vault for your organisation" Style="{StaticResource PageSubHeaderText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="StatusBar" Severity="Success" Title="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="UploadButton" Click="OnUploadClicked" Style="{StaticResource PrimaryAction}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE898;" FontSize="16"/>
                    <TextBlock Text="Upload File"/>
                </StackPanel>
            </Button>
            <Button Click="OnRefreshClicked" Style="{StaticResource Action}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="FileCountText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Grid.Row="3" Text="No files uploaded yet. Click Upload to get started." Opacity="0.4" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

        <ListView x:Name="FileListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Opacity="0.5">
                                <Run Text="by"/>
                                <Run Text="{Binding UploadedBy}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding UploadedAt}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding ContentType}" VerticalAlignment="Center" Opacity="0.5" FontSize="12"/>

                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="#1A0EA5E9" Visibility="{Binding IsShared}">
                            <TextBlock Text="Shared" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <Button Grid.Column="4" ToolTipService.ToolTip="Download" Click="OnDownloadClicked" Tag="{Binding Id}" Padding="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        </Button>

                        <Button Grid.Column="5" ToolTipService.ToolTip="Delete" Click="OnDeleteClicked" Tag="{Binding Id}" Padding="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DangerBrush}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- File Preview Panel (#12) -->
        <Border x:Name="PreviewPanel" Grid.Row="3" Style="{StaticResource CardBorder}" Visibility="Collapsed" 
                HorizontalAlignment="Right" Width="320" Margin="8,0,0,0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PreviewFileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Button Click="OnClosePreview" Padding="4" HorizontalAlignment="Right">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" MaxHeight="400"/>
                <TextBlock x:Name="PreviewUnsupported" Grid.Row="1" Text="Preview not available for this file type" 
                           Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <ProgressBar x:Name="LoadingBar" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>
    </Grid>
</Page>
