<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="24">
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" Style="{StaticResource PageHeaderText}"/>
                <TextBlock x:Name="WelcomeText" Text="Welcome back" Style="{StaticResource PageSubHeaderText}"/>
            </StackPanel>

            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- KPI Cards Row -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Style="{StaticResource CardBorder}" MinWidth="180">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Organisation" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="TenantNameText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" MinWidth="140">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Members" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="MemberCountText" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" MinWidth="140">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="16" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Plan" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="PlanText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" MinWidth="160">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE821;" FontSize="16" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Sector" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="SectorText" Text="—" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Activity Stats (#14) -->
            <StackPanel Spacing="8">
                <TextBlock Text="Activity Overview" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Style="{StaticResource CardBorder}" MinWidth="120">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Tasks" Style="{StaticResource KpiLabel}"/>
                            <TextBlock x:Name="StatTasksText" Text="0" Style="{StaticResource KpiValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" MinWidth="120">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Completed" Style="{StaticResource KpiLabel}"/>
                            <TextBlock x:Name="StatTasksDoneText" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" MinWidth="120">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Files" Style="{StaticResource KpiLabel}"/>
                            <TextBlock x:Name="StatFilesText" Text="0" Style="{StaticResource KpiValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" MinWidth="120">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Notes" Style="{StaticResource KpiLabel}"/>
                            <TextBlock x:Name="StatNotesText" Text="0" Style="{StaticResource KpiValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" MinWidth="120">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Channels" Style="{StaticResource KpiLabel}"/>
                            <TextBlock x:Name="StatChatsText" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Live Events -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Live Activity" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Style="{StaticResource CardBorder}" MinHeight="200">
                    <ListView x:Name="EventsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding EventType}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Source}" Opacity="0.5" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Opacity="0.35" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
