<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/>

            <!-- Tenant Info Cards -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="Organisation" FontSize="12" Opacity="0.6"/>
                        <TextBlock x:Name="TenantNameText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="Plan" FontSize="12" Opacity="0.6"/>
                        <TextBlock x:Name="PlanText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="Members" FontSize="12" Opacity="0.6"/>
                        <TextBlock x:Name="MemberCountText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- Live Events -->
            <TextBlock Text="Live Tenant Events" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" MinHeight="200">
                <ListView x:Name="EventsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                <TextBlock Text="●" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EventType}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Source}" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Timestamp}" Opacity="0.4" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
