<Page
    x:Class="OrgNet.Desktop.Views.TaskBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE9D5;" FontSize="28"/>
            <TextBlock Text="Task Board" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="StatusBar" Severity="Success" Title="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <!-- Summary Cards -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="100">
                <StackPanel>
                    <TextBlock Text="To Do" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="TodoCountText" Text="0" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="100">
                <StackPanel>
                    <TextBlock Text="In Progress" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="InProgressCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="DodgerBlue"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="100">
                <StackPanel>
                    <TextBlock Text="Review" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="ReviewCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="Orange"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="100">
                <StackPanel>
                    <TextBlock Text="Done" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="DoneCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="LimeGreen"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button Click="OnNewTaskClicked" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="New Task"/>
                </StackPanel>
            </Button>
            <Button Click="OnRefreshClicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Task List -->
        <ListView x:Name="TaskListView" Grid.Row="4" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Tag="{Binding Id}" SelectionChanged="OnStatusChanged"
                                  SelectedItem="{Binding Status}" MinWidth="110">
                            <ComboBoxItem Content="Todo"/>
                            <ComboBoxItem Content="InProgress"/>
                            <ComboBoxItem Content="Review"/>
                            <ComboBoxItem Content="Done"/>
                        </ComboBox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Opacity="0.5">
                                <Run Text="{Binding CreatedBy}"/>
                                <Run Text="→"/>
                                <Run Text="{Binding AssignedTo}"/>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Grid.Column="3" Text="{Binding DueDate}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>

                        <Button Grid.Column="4" ToolTipService.ToolTip="Delete" Click="OnDeleteTaskClicked" Tag="{Binding Id}" Padding="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="IndianRed"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar x:Name="LoadingBar" Grid.Row="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>
    </Grid>
</Page>
