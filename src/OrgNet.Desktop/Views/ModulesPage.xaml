<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.ModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE74C;" FontSize="22" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Modules" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Built-in modules that power your organisation" Style="{StaticResource PageSubHeaderText}" MaxWidth="700"/>
            </StackPanel>

            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Error" IsOpen="False" IsClosable="True"/>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <TextBlock x:Name="ModuleCountText" Opacity="0.5" FontSize="13"/>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText" Text="No modules found" Opacity="0.4" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

            <ItemsRepeater x:Name="ModulesList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="12" Opacity="0.4"/>
                                            <TextBlock Text="{Binding Version}" Opacity="0.4" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ModuleId}" Opacity="0.3" FontSize="11" FontFamily="Consolas"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center"
                                        Background="#1A22C55E">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
