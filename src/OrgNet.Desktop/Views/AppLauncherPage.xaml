<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.AppLauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App Launcher Grid -->
        <ScrollViewer Grid.Row="0" x:Name="LauncherPanel" MaxHeight="400" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="App Launcher" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Launch tenant apps and embedded web services" Opacity="0.6"/>

                <ItemsRepeater x:Name="AppGrid">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="180" MinItemHeight="120" MinColumnSpacing="12" MinRowSpacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16" PointerPressed="OnAppTapped">
                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Mode}" Opacity="0.4" FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock x:Name="EmptyText" Text="No services registered. Register services via the API." Opacity="0.4"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- WebView2 for embedded tenant apps -->
        <Grid Grid.Row="1" x:Name="WebViewContainer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="24,8">
                <Button Content="← Back" Click="OnBackToLauncher"/>
                <TextBlock x:Name="WebViewTitle" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <WebView2 Grid.Row="1" x:Name="EmbeddedWebView"/>
        </Grid>
    </Grid>
</Page>
