<Page
    x:Class="OrgNet.Desktop.Views.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE789;" FontSize="28"/>
            <TextBlock Text="Announcements" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Error" IsOpen="False" IsClosable="True"/>
            <InfoBar x:Name="StatusBar" Severity="Success" Title="Success" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Click="OnNewAnnouncementClicked" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="New Announcement"/>
                </StackPanel>
            </Button>
            <Button Click="OnRefreshClicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ListView x:Name="AnnouncementListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="16" Margin="0,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE840;" FontSize="14" Visibility="{Binding IsPinned}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" ToolTipService.ToolTip="Delete" Click="OnDeleteClicked" Tag="{Binding Id}" Padding="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="IndianRed"/>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Body}" TextWrapping="Wrap" Opacity="0.85"/>

                            <TextBlock Grid.Row="2" FontSize="11" Opacity="0.4">
                                <Run Text="by"/>
                                <Run Text="{Binding Author}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding PublishedAt}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar x:Name="LoadingBar" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>
    </Grid>
</Page>
