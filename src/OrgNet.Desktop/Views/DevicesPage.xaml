<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8EA;" FontSize="22" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Devices" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Registered devices and their trust status" Style="{StaticResource PageSubHeaderText}"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <TextBlock x:Name="EmptyText" Text="No devices registered yet" Opacity="0.4" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

            <ItemsRepeater x:Name="DevicesList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Platform}" Opacity="0.6" FontSize="13"/>
                                        <TextBlock Text="{Binding TrustLevel}" Opacity="0.5" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LastIpAddress}" Opacity="0.4" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding UserDisplayName}" Opacity="0.5" FontSize="12"/>
                                        <TextBlock Text="{Binding UserEmail}" Opacity="0.4" FontSize="12"/>
                                        <TextBlock Text="{Binding RegisteredAt}" Opacity="0.3" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                    <Button Content="Approve" Tag="{Binding Id}" Click="OnApproveClick"
                                            Background="#22c55e" Foreground="White" CornerRadius="6" Padding="12,6" FontSize="12"/>
                                    <Button Content="Decline" Tag="{Binding Id}" Click="OnDeclineClick"
                                            Background="#ef4444" Foreground="White" CornerRadius="6" Padding="12,6" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding RiskScore}" Opacity="0.3" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
