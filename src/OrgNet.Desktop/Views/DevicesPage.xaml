<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OrgNet.Desktop.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8EA;" FontSize="22" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Devices" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Registered devices and their trust status" Style="{StaticResource PageSubHeaderText}"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>

            <TextBlock x:Name="EmptyText" Text="No devices registered yet" Opacity="0.4" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

            <ItemsRepeater x:Name="DevicesList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Platform}" Opacity="0.6" FontSize="13"/>
                                        <TextBlock Text="{Binding RegisteredAt}" Opacity="0.4" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrustLevel}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
